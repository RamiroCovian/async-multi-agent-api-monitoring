# App
APP_HOST=0.0.0.0
APP_PORT=8000
APP_ENV=development

# Redis (host 6380 -> contenedor 6379; evita choque con otros Redis locales)
REDIS_URL=redis://localhost:6380/0

# Multi-LLM: gemini | openai | anthropic (default: gemini)
LLM_PROVIDER=gemini

# Gemini (GOOGLE_API_KEY o GEMINI_API_KEY)
GOOGLE_API_KEY=
# GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# Observabilidad — backend: langsmith | phoenix | none
OBSERVABILITY_BACKEND=langsmith
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=async-multi-agent-api-monitoring
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com

# Phoenix (opcional; requiere pip install arize-phoenix openinference-instrumentation-langchain)
# OBSERVABILITY_BACKEND=phoenix
# PHOENIX_COLLECTOR_ENDPOINT=http://localhost:6006
